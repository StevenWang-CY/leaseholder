{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LifecycleEvent",
  "description": "One lifecycle event of one session.",
  "type": "object",
  "properties": {
    "at_ms": {
      "description": "When the emitter observed the event, in Unix epoch milliseconds. The control plane also stamps its own\nmonotonic receipt time and orders events by that.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "event_id": {
      "description": "Idempotency key, 1 to 128 bytes, unique per emitter. A repeat of an id that the same tenant posted from the\nsame source is acknowledged and ignored.",
      "type": "string"
    },
    "session_id": {
      "$ref": "#/$defs/SessionId"
    },
    "source": {
      "$ref": "#/$defs/EventSource"
    }
  },
  "oneOf": [
    {
      "description": "A request for the session reached the control plane.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "turn_started"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "A response finished: why it stopped, and its tokens.",
      "type": "object",
      "properties": {
        "completion_tokens": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "prompt_tokens": {
          "type": "integer",
          "format": "uint32",
          "default": 0,
          "minimum": 0
        },
        "stop_reason": {
          "$ref": "#/$defs/StopReason"
        },
        "type": {
          "type": "string",
          "const": "turn_finished"
        }
      },
      "required": [
        "type",
        "stop_reason"
      ]
    },
    {
      "description": "A server-side tool started; `eta_ms` is when it is expected to return, when known.",
      "type": "object",
      "properties": {
        "eta_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "const": "tool_wait_started"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "The tool returned; the next turn follows.",
      "type": "object",
      "properties": {
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "const": "tool_wait_ended"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "Voice activity onset: a turn is coming, and policy `leaseholder` (`trigger = \"onset\"`) arms its KV headroom.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "user_speech_started"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "The end-of-turn detector decided the user has finished; the realtime request follows within\nmilliseconds.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "user_turn_ended"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "The agent started speaking.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "playback_started"
        }
      },
      "required": [
        "type"
      ]
    },
    {
      "description": "The agent finished speaking.",
      "type": "object",
      "properties": {
        "played_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "playback_ended"
        }
      },
      "required": [
        "type",
        "played_ms"
      ]
    },
    {
      "description": "The user barged in, `played_ms` into the reply: policy `leaseholder` takes it as the user speaking again.\nThe voice agent ends the reply's stream itself.",
      "type": "object",
      "properties": {
        "played_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "interrupted"
        }
      },
      "required": [
        "type",
        "played_ms"
      ]
    },
    {
      "description": "The session ended: the gateway forgets its turn state and, with several GPU nodes, its placement.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "session_closed"
        }
      },
      "required": [
        "type"
      ]
    }
  ],
  "required": [
    "event_id",
    "session_id",
    "at_ms",
    "source"
  ],
  "$defs": {
    "EventSource": {
      "description": "Who emitted an event.",
      "oneOf": [
        {
          "description": "agentic-api's lifecycle sink: exact server-side tool timing.",
          "type": "string",
          "const": "agentic-api"
        },
        {
          "description": "The LiveKit voice worker: voice activity, end of turn, playback, barge-in.",
          "type": "string",
          "const": "voice-worker"
        },
        {
          "description": "Any other trusted client.",
          "type": "string",
          "const": "client"
        }
      ]
    },
    "SessionId": {
      "description": "One conversation, scoped to a tenant: 1 to 128 characters from [A-Za-z0-9._:-].",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "StopReason": {
      "description": "Why a response stopped, normalized across the OpenAI and Anthropic APIs.",
      "oneOf": [
        {
          "description": "Natural end: OpenAI `stop` or `content_filter`; Anthropic `end_turn`, `stop_sequence` or `refusal`.",
          "type": "string",
          "const": "stop"
        },
        {
          "description": "Token limit: OpenAI `length`; Anthropic `max_tokens`.",
          "type": "string",
          "const": "length"
        },
        {
          "description": "The model called tools: OpenAI `tool_calls` or `function_call`; Anthropic `tool_use`.",
          "type": "string",
          "const": "tool_calls"
        },
        {
          "description": "The client or the control plane aborted the stream.",
          "type": "string",
          "const": "cancelled"
        },
        {
          "description": "The upstream failed.",
          "type": "string",
          "const": "error"
        }
      ]
    }
  }
}
