{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LedgerRow",
  "type": "object",
  "properties": {
    "cached_device_tokens": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "cached_host_tokens": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "class": {
      "$ref": "#/$defs/SloClass"
    },
    "completion_tokens": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "config": {
      "description": "Name of the serving configuration, so rows from different setups never mix.",
      "type": "string"
    },
    "engine_epoch": {
      "description": "The engine's identity when it served the request. A change voids every lease held on the old epoch.",
      "type": "string"
    },
    "expected_reusable_tokens": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "first_sentence_ms": {
      "description": "Realtime only: receipt to the end of the first sentence, the stage that dominates voice-to-voice latency.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "first_token_ms": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "node": {
      "description": "The GPU node that served the request.",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "prefill_ms": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "prompt_tokens": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "queue_ms": {
      "description": "Stage durations in milliseconds; absent when the engine did not report the stage.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "received_at_ms": {
      "description": "Receipt at the control plane, in Unix epoch milliseconds.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "recompute": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RecomputeSpan"
      }
    },
    "recomputed_tokens": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "request_id": {
      "type": "string"
    },
    "restore_ms": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "session_id": {
      "$ref": "#/$defs/SessionId"
    },
    "synthetic": {
      "description": "A control-plane prefetch warm-up. Synthetic rows are excluded from every SLI and from usage.",
      "type": "boolean",
      "default": false
    },
    "total_ms": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    }
  },
  "required": [
    "request_id",
    "session_id",
    "class",
    "node",
    "engine_epoch",
    "config",
    "outcome",
    "prompt_tokens",
    "completion_tokens",
    "expected_reusable_tokens",
    "cached_device_tokens",
    "cached_host_tokens",
    "recomputed_tokens",
    "received_at_ms"
  ],
  "$defs": {
    "Outcome": {
      "type": "string",
      "enum": [
        "completed",
        "cancelled",
        "error"
      ]
    },
    "RecomputeSpan": {
      "description": "A run of recomputed tokens and the reason they were recomputed.",
      "type": "object",
      "properties": {
        "tokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "description": "A first turn whose shared prefix (system prompt, tools) was not cached.",
          "type": "object",
          "properties": {
            "cause": {
              "type": "string",
              "const": "cold_first_turn"
            }
          },
          "required": [
            "cause"
          ]
        },
        {
          "description": "The prompt diverged from what the session sent before, for example a timestamp or a chat template\nre-rendering tool-call JSON. `position` is the first differing token.",
          "type": "object",
          "properties": {
            "cause": {
              "type": "string",
              "const": "prefix_break"
            },
            "field": {
              "description": "The field that differs, when known (for example `tool_calls[0].arguments`).",
              "type": [
                "string",
                "null"
              ]
            },
            "message": {
              "description": "Index of the message that differs, when known.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            },
            "position": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "cause",
            "position"
          ]
        },
        {
          "description": "Evicted from both the GPU pool and the CPU tier.",
          "type": "object",
          "properties": {
            "cause": {
              "type": "string",
              "const": "evicted_gpu_and_cpu"
            }
          },
          "required": [
            "cause"
          ]
        },
        {
          "description": "The lease expired before the session came back.",
          "type": "object",
          "properties": {
            "cause": {
              "type": "string",
              "const": "lease_expired"
            }
          },
          "required": [
            "cause"
          ]
        },
        {
          "description": "Routed to a node that does not hold the session's KV.",
          "type": "object",
          "properties": {
            "cause": {
              "type": "string",
              "const": "holder_miss"
            }
          },
          "required": [
            "cause"
          ]
        },
        {
          "description": "The engine preempted the request and recomputed it.",
          "type": "object",
          "properties": {
            "cause": {
              "type": "string",
              "const": "preempted"
            }
          },
          "required": [
            "cause"
          ]
        },
        {
          "description": "The engine restarted (a new epoch), so its caches were empty.",
          "type": "object",
          "properties": {
            "cause": {
              "type": "string",
              "const": "epoch_change"
            }
          },
          "required": [
            "cause"
          ]
        },
        {
          "description": "No cause could be determined, for example after a KV-event gap. Reported as its own share.",
          "type": "object",
          "properties": {
            "cause": {
              "type": "string",
              "const": "unknown"
            }
          },
          "required": [
            "cause"
          ]
        }
      ],
      "required": [
        "tokens"
      ]
    },
    "SessionId": {
      "description": "One conversation, scoped to a tenant: 1 to 128 characters from [A-Za-z0-9._:-].",
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "SloClass": {
      "description": "The SLO class of a request: which clock it runs on. Classes order from strictest to most lenient.",
      "oneOf": [
        {
          "description": "Voice turns. Never rejected: admission makes room, then degrades the reply.",
          "type": "string",
          "const": "realtime"
        },
        {
          "description": "Agent loops with a person waiting. Predicted-TTFT admission; queued with a deadline.",
          "type": "string",
          "const": "interactive"
        },
        {
          "description": "Batch agents, trace replays, memory consolidation. Best effort with a minimum share; deferred or demoted\nwhenever realtime needs room.",
          "type": "string",
          "const": "background"
        }
      ]
    }
  }
}
