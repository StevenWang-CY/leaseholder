[Unit]
Description=Leaseholder SSH tunnel from cyan to Phastform's loopback services
Documentation=https://github.com/StevenWang-CY/leaseholder/blob/main/ops/RUNBOOK.md

[Service]
Type=exec
# TCP forwards serve the host network (control plane, load generators, smoke tests); Unix-socket forwards serve
# the voice-plane namespace, which has no route out. Phastform authorizes this key for these ports only.
# The SSH target (user@host) is host-specific and lives outside the repository, as LH_TUNNEL_TARGET.
EnvironmentFile=%h/.config/leaseholder/tunnel-phastform.env
ExecStartPre=/usr/bin/mkdir -p %t/lh
ExecStart=/usr/bin/ssh -N -T -i %h/.ssh/lh_tunnel_ed25519 \
  -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
  -o ExitOnForwardFailure=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
  -o StreamLocalBindUnlink=yes \
  -L 127.0.0.1:18000:127.0.0.1:8000 -L 127.0.0.1:18100:127.0.0.1:8100 -L 127.0.0.1:18880:127.0.0.1:8880 \
  -L %t/lh/phastform-engine.sock:127.0.0.1:8000 -L %t/lh/phastform-stt.sock:127.0.0.1:8100 \
  -L %t/lh/phastform-tts.sock:127.0.0.1:8880 \
  ${LH_TUNNEL_TARGET}
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
