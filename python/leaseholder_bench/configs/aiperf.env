# Environment for `aiperf profile --config configs/agentic_replay.yaml`; source it in the shell
# that runs AIPerf. AIPerf 0.13.0 reads these settings only from the environment.

# Do not keep a second, memory-mapped copy of every dataset under ~/.cache/aiperf. It would not save the dataset
# build either: AIPerf 0.13.0 caches only its own trace types (mmap_cache.TRACE_VERBATIM_DATASET_TYPES), and the
# plugin's weka_trace_scaled is not one, so every run rebuilds the dataset (about 4 minutes on cyan).
export AIPERF_DATASET_MMAP_CACHE_ENABLED=false
# Keep off: when on, AIPerf overwrites the plugin's X-Session-ID (the session-tree root, shared by
# a parent and its subagents) with each agent's own correlation id.
export AIPERF_HTTP_X_SESSION_ID_FROM_CORRELATION_ID=false
# Weka loader processes (AIPerf's default is one per core, up to 16).
export AIPERF_DATASET_WEKA_PARALLEL_WORKERS=4
# Loading the full scaled corpus takes about 300 s, AIPerf's default timeout.
export AIPERF_DATASET_CONFIGURATION_TIMEOUT=900
export AIPERF_SERVICE_PROFILE_CONFIGURE_TIMEOUT=900

# leaseholder_chat endpoint: class of every replayed session, an optional JSON file of
# trace id -> class, and whether to send the vLLM priority field (false sends none, as a plain
# client would; vLLM acts on it only under --scheduling-policy priority).
export LH_BENCH_CLASS=background
# export LH_BENCH_CLASS_MAP=classes.json
# export LH_BENCH_SEND_PRIORITY=false
